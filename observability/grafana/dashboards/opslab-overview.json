{
  "uid": "opslab-overview",
  "title": "OpsLab API overview",
  "tags": [
    "opslab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opslab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opslab-prometheus"
          },
          "expr": "sum by (route) (rate(opslab_http_requests_total[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Latency p50 / p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opslab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opslab-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(opslab_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opslab-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(opslab_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Error ratio (5xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "opslab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opslab-prometheus"
          },
          "expr": "sum(rate(opslab_http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(opslab_http_requests_total[1m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Active incidents",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "opslab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opslab-prometheus"
          },
          "expr": "opslab_active_incidents",
          "legendFormat": "incidents",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Services",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "opslab-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opslab-prometheus"
          },
          "expr": "opslab_services_total",
          "legendFormat": "services",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Fault injected",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "opslab-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 8,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opslab-prometheus"
          },
          "expr": "opslab_chaos_active",
          "legendFormat": "chaos",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "green"
                },
                "1": {
                  "text": "Yes",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    }
  ]
}
