NODE_ENV=development
PORT=3000
OPSLAB_PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=opslab
DATABASE_USER=opslab
DATABASE_PASSWORD=development
# Fault injection for the incident lab: on in development, off in production unless set to "on"
OPSLAB_CHAOS=on
# Optional: require this value in an x-opslab-chaos-token header to change faults
# OPSLAB_CHAOS_TOKEN=
# Optional: export traces to an OTLP collector such as Jaeger, and link to its UI
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OPSLAB_TRACE_UI=http://localhost:16686
